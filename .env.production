# ==============================================================================
# Production Environment Configuration - Phased Rollout
# ==============================================================================

PORT=3000
NODE_ENV=production

# Gemini AI API Configuration
GEMINI_API_KEY=your_production_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004
MAX_CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.60

# Production Persistent Data Directory & Permanent Data Vault
DATA_DIR=/app/data
DATA_VAULT_PATH=/app/data/vault
VECTOR_DB_PATH=/app/data/vector_store.json
CATEGORIES_FILE_PATH=/app/data/categories.json

# Cloud Storage Vault Bucket (Google Cloud / Firebase Storage)
GCS_BUCKET_NAME=masruq-rag-raw-books-vault
FIREBASE_STORAGE_BUCKET=masruq-rag-raw-books-vault.appspot.com

# Multi-Domain Network Routing
BACKEND_API_URL=https://api.misruq.com
SUPERVISOR_DOMAIN=waraqa.misruq.com
CHAT_DOMAIN=bahth.misruq.com
ADMIN_DOMAIN=logs.misruq.com
