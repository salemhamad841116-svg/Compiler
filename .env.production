# ==============================================================================
# Production Environment Configuration - Phased Rollout
# ==============================================================================

PORT=3000
NODE_ENV=production

# Gemini AI API Configuration
GEMINI_API_KEY=your_production_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
OCR_MODEL=gemini-3.6-flash
TRANSCRIPTION_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
MAX_CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.45

# Phase 4: API keys can also be managed from Admin > System Settings (stored AES-256-GCM encrypted in the DB).
# Priority: DB primary -> DB fallback 1 -> DB fallback 2 -> GEMINI_API_KEY above.
# Optional master key for that encryption; if unset, one is generated once at $DATA_DIR/.settings.key.
# SETTINGS_ENCRYPTION_KEY=

# Production Persistent Data Directory & Permanent Data Vault
DATA_DIR=/app/data
DATA_VAULT_PATH=/app/data/vault
VECTOR_DB_PATH=/app/data/vector_store.json
CATEGORIES_FILE_PATH=/app/data/categories.json

# Cloud Storage Vault Bucket (Google Cloud / Firebase Storage)
GCS_BUCKET_NAME=masruq-rag-raw-books-vault
FIREBASE_STORAGE_BUCKET=masruq-rag-raw-books-vault.appspot.com

# Multi-Domain Network Routing
BACKEND_API_URL=https://api.misruq.com
SUPERVISOR_DOMAIN=waraqa.misruq.com
CHAT_DOMAIN=bahth.misruq.com
ADMIN_DOMAIN=logs.misruq.com

# Admin Authentication & Bootstrap
ADMIN_EMAIL=admin@misruq.com
ADMIN_INITIAL_PASSWORD=Admin@Misruq2026!
ADMIN_NAME=Admin
DB_PATH=/app/data/platform.db
CORS_ORIGINS=https://waraqa.misruq.com,https://logs.misruq.com,https://admin.misruq.com,https://bahth.misruq.com
