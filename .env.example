# ==============================================================================
# Enterprise RAG & Permanent Data Vault Configuration
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=production

# Gemini Generative AI & Embeddings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
OCR_MODEL=gemini-3.6-flash
TRANSCRIPTION_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
MAX_CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.60

# Permanent Production Storage & Data Vault Paths
DATA_DIR=/app/data
DATA_VAULT_PATH=/app/data/vault
VECTOR_DB_PATH=/app/data/vector_store.json
CATEGORIES_FILE_PATH=/app/data/categories.json

# Cloud Storage Bucket (Google Cloud Storage / Firebase Cloud Storage)
GCS_BUCKET_NAME=masruq-rag-raw-books-vault
FIREBASE_STORAGE_BUCKET=masruq-rag-raw-books-vault.appspot.com
# GOOGLE_APPLICATION_CREDENTIALS=/app/config/service-account.json

# Subdomain & Production Service Endpoints
BACKEND_API_URL=https://api.msruq.com
SUPERVISOR_DOMAIN=waraqa.msruq.com
CHAT_DOMAIN=bahth.masruq.com
ADMIN_DOMAIN=logs.msruq.com

# Optional Backend Scraping Proxy (never exposed to UI)
# SCRAPING_PROXY_URL=https://api.scraperproxy.example/scrape

# --- Administration system (required for authentication) ---
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Administrator
# SQLite database file (must live on a persistent volume)
DB_PATH=/app/data/platform.db
# gemini (real) or mock (tests only)
AI_PROVIDER=gemini
# GEMINI_API_KEY is defined ONCE at the top of this file. Do not repeat it here:
# with env files the LAST occurrence wins, so a placeholder below would override the real key.
CORS_ORIGINS=https://waraqa.msruq.com,https://logs.msruq.com,https://bahth.msruq.com
