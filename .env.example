PORT=3000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004
MAX_CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
